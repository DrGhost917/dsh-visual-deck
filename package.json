{
  "name": "dsh-visual-deck",
  "version": "0.2.0",
  "type": "module",
  "main": "index.js",
  "description": "DeepSeek Harness 的启动动画与会话背景管理器：导入本地图片/视频，视频设为启动动画（带声音、可调音量与播放时机），图片或视频设为会话背景（强度/模糊/临时开关）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "wallpaper",
    "background",
    "startup-animation",
    "splash",
    "video",
    "skin"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "runtime",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
